# Copy this file to .env and fill in real values. NEVER commit .env.
# Read these through config.get_required_env(), never hard-code them.

# xAI / Grok API key (https://console.x.ai)
XAI_API_KEY=

# Grok model ID to use; check the xAI docs for current model names.
XAI_MODEL=

# xAI Grok API endpoint (Grok only; no other AI provider is used).
XAI_BASE_URL=https://api.x.ai/v1

# --- Deployment settings (optional; set them in the host's secrets, not in git) ---

# Shows a login form before the dashboard. Leave empty for local development.
EARTHWATCH_ACCESS_CODE=

# Caps real Grok jobs per server run to protect your credits (each investigation,
# hazard-globe review, seasonal watch or weather brief counts as one).
# 0 removes the cap; empty uses the default of 60.
EARTHWATCH_MAX_INVESTIGATIONS=

# Where downloaded data is cached (use /tmp/earthwatch on read-only hosts).
# EARTHWATCH_CACHE_DIR=.cache/earthwatch
