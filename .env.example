# Copy this file to .env and fill in real values. NEVER commit .env.
# Read these through config.get_required_env(), never hard-code them.

# xAI / Grok API key (https://console.x.ai)
XAI_API_KEY=

# Grok model ID to use; check the xAI docs for current model names.
XAI_MODEL=

# OpenAI-compatible endpoint for the Grok API.
XAI_BASE_URL=https://api.x.ai/v1
